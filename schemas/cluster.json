{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECS Cluster Configuration",
  "type": "object",
  "required": ["name", "region"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the ECS cluster."
    },
    "region": {
      "type": "string",
      "description": "AWS region where the cluster resides."
    },
    "capacityProviders": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["FARGATE", "FARGATE_SPOT"]
      },
      "description": "List of capacity providers."
    },
    "defaultCapacityProviderStrategy": {
      "type": "array",
      "items": { "$ref": "#/definitions/capacityProvider" },
      "description": "Default capacity provider strategy used by service and task launches."
    },
    "serviceConnectDefaultsNamespace": {
      "type": "string",
      "description": "Cloud Map namespace used by new Service Connect-enabled services."
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Key-value pairs for resource tags."
    }
  },
  "definitions": {
    "capacityProvider": {
      "type": "object",
      "properties": {
        "capacityProvider": { "type": "string" },
        "weight": { "type": "integer", "minimum": 0 },
        "base": { "type": "integer", "minimum": 0 }
      },
      "required": ["capacityProvider"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
